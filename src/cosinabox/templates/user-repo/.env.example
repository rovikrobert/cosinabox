# Copy to .env and fill in. Never commit .env.

# Required
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google (Gmail + Calendar)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN_1=
# GOOGLE_OAUTH_REFRESH_TOKEN_2=  # optional second account

# Optional integrations — enable in integrations.yaml after setting the key
# ATTIO_API_KEY=              # CRM (attio.com)
# FIREFLIES_API_KEY=          # Meeting transcripts (fireflies.ai)
# SERPER_API_KEY=              # Web search (serper.dev)

# Memory service (optional — local SQLite keyword search works by default)
# MEMORY_SERVICE_URL=           # External memory service (e.g., Railway-hosted)
# MEMORY_API_KEY=               # Bearer token for the memory service

# Consult endpoint (cosinabox consult-serve --transport http)
# Required only when serving over HTTP; leave blank for local stdio.
CONSULT_API_KEY=
